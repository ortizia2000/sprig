# Copy to .env for local runs. In production these live as GitHub Actions secrets.
# NEVER commit real tokens.

# --- Instagram: easiest flow is Direct Login (no Facebook Page needed) ---
# Long-lived (60-day) token from "API setup with Instagram Login".
# If set, IG calls use graph.instagram.com with this token; if empty, Instagram
# falls back to the Page token below (IG account must then be linked to the Page).
IG_ACCESS_TOKEN=
IG_USER_ID=17841434173594422   # @myceliumai.co Instagram business/user id

# --- Meta Page token (required for Facebook; also covers Instagram if linked) ---
META_ACCESS_TOKEN=          # Page access token (ideally a never-expiring System User token)
FB_PAGE_ID=                 # Mycelium AI Facebook Page id

# --- LinkedIn (optional, needs its own app + Community Management API approval) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=

# --- Where Instagram fetches images from (raw GitHub by default) ---
MEDIA_BASE_URL=https://raw.githubusercontent.com/ortizia2000/sprig/main/content/media
